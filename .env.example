# ---------------------------------------------------------------------------
# Asadzadeh — environment reference
#
# Copy to `.env.local` for development. Never commit a filled-in copy.
#
# Variables are grouped by what happens if they are missing:
#   1. REQUIRED IN PRODUCTION  — the app refuses to boot without them
#   2. OPTIONAL                — a feature is off until they are set
#   3. DEVELOPMENT / TEST ONLY — never needed on a server
#
# A blank value (`KEY=`) is treated as *absent*, not invalid: hosting panels
# write empty strings for unset variables.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. REQUIRED IN PRODUCTION
# ===========================================================================

# Production refuses to start if any of these is missing or blank.

# Session + video-token signing key. Minimum 32 characters in production.
#   openssl rand -hex 32
APP_SECRET=

# PostgreSQL. The only datastore. There is no SQLite, JSON or demo fallback in
# production — boot fails fast without this.
DATABASE_URL=postgres://user:password@host:5432/asadzadeh

# Public origin of the site. Used for canonical URLs, the sitemap and payment
# callbacks. Must be the URL customers actually type.
NEXT_PUBLIC_APP_URL=https://example.com

# --- Object storage (S3-compatible, PRIVATE bucket) -------------------------
#
# Course videos and lesson attachments live here. A PaaS container disk is
# wiped on every deploy, so production refuses to accept uploads while these
# are unset rather than storing paid-for material somewhere it will vanish.
#
# The bucket MUST be private: no public-read ACL, no bucket policy, listing
# disabled. Nothing in the app produces a public object URL — playback is
# proxied through an authorising route, so no key or credential reaches a
# browser.
#
# Both spellings of the credential pair are accepted; use whichever your
# provider's console shows you.
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=asadzedeh
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# S3_REGION=us-east-1
# Leave path-style on unless the provider requires virtual-host addressing.
# S3_FORCE_PATH_STYLE=true
# Only set this if objects are also served through your own CDN. The app never
# needs it, and setting it does not make objects public.
# S3_PUBLIC_BASE_URL=


# ===========================================================================
# 2. OPTIONAL
# ===========================================================================

# --- Payments: Zibal (زیبال) is the launch gateway --------------------------
# Environment values win over whatever the admin panel stored, so the merchant
# string can stay out of the database. Amounts leave the app in Rial (Toman×10).
# ZIBAL_MERCHANT=
# PAYMENT_PROVIDER=zibal          # zibal | zarinpal | idpay | payping
#
# Production ignores the stored sandbox flag; only this enables it.
# PAYMENT_SANDBOX=false
#
# Other gateways (still supported):
# ZARINPAL_MERCHANT_ID=
# PAYMENT_MERCHANT_ID=
# PAYMENT_SECRET=                 # only OAuth gateways (PayPing) need this

# --- SMS: MeliPayamak (ملی پیامک) is the launch panel -----------------------
# Setting both credentials is enough; the provider is inferred as melipayamak.
# These are the panel's *web-service* username and password, not the site login.
# MELIPAYAMAK_USERNAME=
# MELIPAYAMAK_PASSWORD=
# SMS_SENDER_NUMBER=              # dedicated line, once the panel issues one
# SMS_TEMPLATE_ID=                # service-number template for one-time codes
# SMS_PROVIDER=melipayamak        # melipayamak | kavenegar | ghasedak | smsir

# --- Observability ---------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_ANALYTICS_ID=

# --- Database TLS ----------------------------------------------------------
# Set when the managed PostgreSQL requires TLS. The server certificate IS
# verified by default. Only disable verification if the provider uses a private
# CA you cannot pin — doing so means anyone on the path can impersonate the
# database and read every query.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Maps ------------------------------------------------------------------
# NEXT_PUBLIC_NESHAN_MAP_KEY=
# NESHAN_SERVICE_API_KEY=
# WORKSHOP_LAT=
# WORKSHOP_LNG=

# --- Runtime tuning --------------------------------------------------------
# LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent
# RESERVATION_SWEEP_MINUTES=10    # abandoned-basket reaper interval
# RESERVATION_TTL_MINUTES=30      # how long a basket holds stock

# --- First administrator (scripts/bootstrap-admin.ts) ----------------------
# SUPER_ADMIN_PHONE=09120000000
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=مدیر ارشد


# ===========================================================================
# 3. DEVELOPMENT / TEST ONLY — never set these on a server
# ===========================================================================

# Local fallback database, used only when DATABASE_URL is unset. Production
# refuses to boot without DATABASE_URL, so this can never take over there.
# PGLITE_DIR=data/pglite          # PGLITE_DIR=memory for an ephemeral test run

# Demo seed data and the demo payment gateway are blocked in production unless
# explicitly re-enabled. Leave both unset on a server.
# ALLOW_DEMO_SEED=true
# ALLOW_DEMO_PAYMENT=true

# Test harness targets (scripts/smoke.ts, security-audit.ts, scenario-test.ts).
# SMOKE_BASE_URL=http://127.0.0.1:4700
# SECURITY_BASE_URL=http://127.0.0.1:4700
# SCENARIO_BASE_URL=http://127.0.0.1:4700
# SCENARIO_ADMIN_PHONE=
# SCENARIO_ADMIN_PASSWORD=
# LOAD_BASE_URL=http://127.0.0.1:4700

# E2E (Playwright)
# npm run test:e2e:install
# E2E_PORT=4321
