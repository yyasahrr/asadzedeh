# Copy to .env.local for Next.js / Node. Never commit real secrets.

NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Public site URL used for canonical, sitemap, payment callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production (min 32 chars). openssl rand -hex 32
APP_SECRET=

# PostgreSQL. Required in production. Development falls back to PGlite under data/pglite.
DATABASE_URL=
# DATABASE_SSL=true

# Demo seed / demo payment are blocked in production unless explicitly allowed
# ALLOW_DEMO_PAYMENT=true
# ALLOW_DEMO_SEED=true

# First super_admin (scripts/bootstrap-admin.ts)
# SUPER_ADMIN_PHONE=09120000000
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=مدیر ارشد

# Object storage (S3-compatible: Liara, Arvan, MinIO, AWS). Without these, files stay in data/object-store
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=asadzedeh
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=true

# Observability
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ANALYTICS_ID=
LOG_LEVEL=info

# Payments
# ZARINPAL_MERCHANT_ID=

# Video / SpotPlayer
# SPOTPLAYER_API_KEY=
# FFMPEG_PATH=

# Neshan maps
NEXT_PUBLIC_NESHAN_MAP_KEY=
NESHAN_SERVICE_API_KEY=
WORKSHOP_LAT=
WORKSHOP_LNG=

# --- Development / testing only -------------------------------------------
# Local fallback database used when DATABASE_URL is unset. Never used in
# production (the app refuses to start there without DATABASE_URL).
# Set PGLITE_DIR=memory for an ephemeral in-memory database (test runs).
#PGLITE_DIR=data/pglite
#
# There is no write-ahead log. PostgreSQL is the only store; the JSON file and
# the WAL that used to buffer writes have both been removed.

# --- E2E (Playwright) -----------------------------------------------------
# npm run test:e2e:install   # downloads Chromium
# npm run test:e2e
#E2E_PORT=4321
