# Neshan Web SDK key (visible in the browser; restrict it to your production domain)
NEXT_PUBLIC_NESHAN_MAP_KEY=

# Neshan service key used only on the server to resolve the workshop address
NESHAN_SERVICE_API_KEY=

# Optional fallback coordinates if the search service is unavailable
WORKSHOP_LAT=
WORKSHOP_LNG=

# --- امنیت / ویدیو / فروشگاه ---
# کلید اصلی برنامه: امضای توکن‌های پخش ویدیو، کوکی‌های ورود دومرحله‌ای و رمزنگاری TOTP secret در دیتابیس.
# حتماً در پروداکشن مقدار تصادفی و طولانی بگذارید (مثلاً: openssl rand -hex 32)
APP_SECRET=

# مسیر باینری ffmpeg برای تبدیل HLS و سوزاندن واترمارک (اختیاری؛ بدون آن پلیر امن با واترمارک متحرک کار می‌کند)
FFMPEG_PATH=

# کلید API اسپات‌پلیر (اختیاری؛ از پنل panel.spotplayer.ir) — بدون آن حالت نمایشی/دمو فعال است
SPOTPLAYER_API_KEY=
