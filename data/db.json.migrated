  "articles": [
    {
      "slug": "madder-red-guide",
      "title": "قرمز روناس؛ شناسنامه رنگ فرش ایرانی",
      "category": "رنگ‌شناسی",
      "excerpt": "چرا قرمز فرش‌های قدیمی بعد از صد سال هنوز زنده است؟ سفری به دنیای روناس، دندانه و حمام رنگ.",
      "minutes": 8,
      "date": "۱۲ شهریور ۱۴۰۵",
      "image": "/images/course-dye.jpg",
      "body": [
        "اگر فرش عتیقه‌ای را از نزدیک دیده باشید، حتماً قرمز عمیق و زنده آن توجه‌تان را جلب کرده است؛ قرمزی که نه تند و زننده است و نه مرده و کدر. این همان «قرمز روناس» است؛ رنگی که از ریشه گیاه روناس به دست می‌آید و قرن‌ها شناسنامه فرش ایرانی بوده است.",
        "راز ماندگاری این رنگ در سه چیز است: کیفیت ریشه، دندانه‌دادن درست و صبر در حمام رنگ. بافندگان قدیمی پشم را ساعت‌ها در محلول زاج می‌خواباندند و سپس آن را آرام‌آرام در حمام روناس می‌پختند؛ فرایندی که گاهی دو روز طول می‌کشید.",
        "امروز با آمدن رنگ‌های شیمیایی، بسیاری از کارگاه‌ها سراغ راه میان‌بر رفته‌اند؛ اما فرش‌هایی که با رنگ طبیعی بافته می‌شوند، هم ارزش هنری بالاتری دارند و هم با گذر زمان زیباتر می‌شوند. در دوره رنگرزی سنتی ما، فرمول کامل قرمز روناس را قدم‌به‌قدم اجرا می‌کنیم."
      ]
    },
    {
      "slug": "buy-first-loom",
      "title": "راهنمای خرید اولین دار قالی",
      "category": "راهنمای خرید",
      "excerpt": "فلزی یا چوبی؟ چه ابعادی؟ از کجا بخریم؟ همه چیزهایی که قبل از خرید اولین دار باید بدانید.",
      "minutes": 6,
      "date": "۵ شهریور ۱۴۰۵",
      "image": "/images/workshop-loom.jpg",
      "body": [
        "بزرگ‌ترین اشتباه هنرجویان تازه‌کار، خرید دار نامناسب است: یا آن‌قدر بزرگ که در خانه جا نمی‌شود، یا آن‌قدر بی‌کیفیت که چله را شل می‌کند و بافت را خراب.",
        "برای شروع، یک دار فلزی سبک ۶۰×۹۰ کافی است؛ هم جابه‌جایی‌اش راحت است، هم برای قالیچه‌های تمرینی جواب می‌دهد. اگر قصد بافت جدی دارید، دار چوبی گردان انتخاب بهتری است چون فشار چله را یکنواخت نگه می‌دارد.",
        "نکته مهم: قبل از خرید، حتماً با استاد خودتان مشورت کنید. هنرجویان دوره مقدماتی ما لیست خرید دقیق با آدرس فروشگاه‌های معتبر دریافت می‌کنند."
      ]
    },
    {
      "slug": "kilim-vs-gabbeh",
      "title": "تفاوت گلیم، گبه و جاجیم به زبان ساده",
      "category": "شناخت بافت",
      "excerpt": "هر سه بدون گره بافته می‌شوند اما دنیای متفاوتی دارند؛ این راهنما را بخوانید بعد مسیرتان را انتخاب کنید.",
      "minutes": 5,
      "date": "۲۸ مرداد ۱۴۰۵",
      "image": "/images/course-kilim.jpg",
      "body": [
        "گلیم، گبه و جاجیم هر سه از خانواده «بافت‌های بدون گره» هستند؛ یعنی به‌جای گره‌زدن دور تار، پود از میان تارها عبور می‌کند و طرح را می‌سازد.",
        "گلیم بافتی ظریف و تخت با نقوش هندسی منظم است و معمولاً از روی نقشه یا ذهنی منظم بافته می‌شود. گبه بافتی ضخیم‌تر، بلندپرزتر و کاملاً ذهنی است؛ بافنده هرچه در دل دارد می‌بافد. جاجیم هم بافتی راه‌راه و رنگارنگ است که بیشتر برای رختخواب‌پیچ و پرده کاربرد داشت.",
        "اگر منظم و دقیق هستید از گلیم شروع کنید؛ اگر رها و خلاق، گبه منتظر شماست."
      ]
    },
    {
      "slug": "carpet-investment",
      "title": "آیا فرش دستباف هنوز سرمایه است؟",
      "category": "بازار فرش",
      "excerpt": "نگاهی واقع‌بینانه به بازار فرش دستباف، قیمت‌گذاری آثار هنرجویی و مسیر فروش اول.",
      "minutes": 10,
      "date": "۲۰ مرداد ۱۴۰۵",
      "image": "/images/course-carpet.jpg",
      "body": [
        "پرسشی که هر هنرجو می‌پرسد: «آیا می‌توانم از بافت پول دربیاورم؟» پاسخ کوتاه: بله، اما نه با عجله و نه با هر کیفیتی.",
        "بازار فرش دستباف امروز دو قطبی شده است: فرش‌های بی‌کیفیت و عجولانه تقریباً خریدار ندارند، اما آثار خوش‌بافت با رنگ طبیعی و طرح اصیل، هم در بازار داخلی و هم در صادرات مشتری دارند.",
        "توصیه ما: شش ماه اول فقط برای یادگیری ببافید. از اثر سوم به بعد، با راهنمایی استاد قیمت‌گذاری کنید و فروش اول را تجربه کنید. بسیاری از هنرجویان ما هزینه دوره را از فروش دومین قالیچه‌شان درآورده‌اند."
      ]
    }
  ],
